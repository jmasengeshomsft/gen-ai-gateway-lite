<!-- Multi-tenant AI Gateway Policy: Auth + Rate Limiting + Token Metrics + Routing -->
<policies>
    <inbound>
        <base />
        <!-- ═══════════════════════════════════════════════════════════════════
             STEP 1: Extract Model Name (for routing and metrics)
             ═══════════════════════════════════════════════════════════════════ -->
        <!-- 1a – deployment-id from the route template -->
        <set-variable name="deployment" value="@(context.Request.MatchedParameters.ContainsKey("deployment-id") 
                           ? context.Request.MatchedParameters["deployment-id"] 
                           : string.Empty)" />
        <!-- 1b – model from the request body (JSON) -->
        <set-variable name="reqBody" value="@(context.Request.Body?.As<JObject>(preserveContent:true) 
                           ?? new JObject())" />
        <set-variable name="model" value="@( ((JObject)context.Variables["reqBody"])
                              .Property("model")?.Value?.ToString() 
                              ?? string.Empty)" />
        <!-- 1c – first non-empty of deployment-id or model -->
        <set-variable name="requestedModel" value="@( !string.IsNullOrEmpty((string)context.Variables["deployment"]) 
                           ? (string)context.Variables["deployment"]
                           : (string)context.Variables["model"] )" />
        <!-- ═══════════════════════════════════════════════════════════════════
             STEP 2: Managed Identity Auth (Cognitive Services)
             ═══════════════════════════════════════════════════════════════════ -->
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" 
                                         output-token-variable-name="managed-id-access-token" 
                                         ignore-error="false" />
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["managed-id-access-token"])</value>
        </set-header>
        <!-- ═══════════════════════════════════════════════════════════════════
             STEP 3: TPM Rate Limit (llm-token-limit) + Redis Quota Counter

             TPM  : enforced by llm-token-limit — per-process in-memory, resets
                    every minute.  Fast path, no external round-trip.

             Quota: enforced by Redis cache-lookup-value / cache-store-value.
                    Key = "quota:{subscriptionId}:{periodBucket}"
                    e.g. "quota:abc123:202504" for Monthly quota in Apr 2025.
                    All processes and replicas share the same Redis key, so the
                    counter is globally consistent across IIS workers (v1) and
                    ACA replicas (v2).  TTL = length of the quota period.

             Step 3 is split into two phases:
               3A — Resolve tenant config (key, limit, TTL, TPM cap, period label).
               3B — Shared enforcement block (lookup, reject if exhausted, TPM limit).
             ═══════════════════════════════════════════════════════════════════ -->

        <!-- ─── 3A: Resolve per-tenant quota configuration ────────────────── -->
        <choose>
%{ for sub in tenant_subscriptions ~}
            <!-- ${sub.display_name}: ${sub.tokens_per_minute} TPM | ${sub.token_quota} ${sub.token_quota_period} quota (Redis-backed) -->
            <when condition="@(context.Subscription.Id == &quot;${sub.subscription_id}&quot;)">
                <set-variable name="tenantQuotaKey"
                              value="@(&quot;quota:${sub.subscription_id}:&quot; + DateTime.UtcNow.ToString(&quot;${sub.quota_date_fmt}&quot;))" />
                <set-variable name="tenantQuotaLimit" value="@(${sub.token_quota}L)" />
                <set-variable name="quotaTtlSeconds"  value="@(${sub.quota_ttl_seconds})" />
                <set-variable name="tpmCap"           value="@(${sub.tokens_per_minute})" />
                <set-variable name="quotaPeriodLabel" value="${sub.token_quota_period}" />
            </when>
%{ endfor ~}
            <otherwise>
                <!-- Default / lab subscription -->
                <set-variable name="tenantQuotaKey"
                              value="@(&quot;quota:&quot; + context.Subscription.Id + &quot;:&quot; + DateTime.UtcNow.ToString(&quot;${default_quota_date_fmt}&quot;))" />
                <set-variable name="tenantQuotaLimit" value="@(${default_token_quota}L)" />
                <set-variable name="quotaTtlSeconds"  value="@(${default_quota_ttl_seconds})" />
                <set-variable name="tpmCap"           value="@(${default_tokens_per_minute})" />
                <set-variable name="quotaPeriodLabel" value="${default_token_quota_period}" />
            </otherwise>
        </choose>

        <!-- ─── 3B: Shared enforcement (lookup, reject, TPM limit) ────────── -->
        <cache-lookup-value key="@((string)context.Variables[&quot;tenantQuotaKey&quot;])"
                            variable-name="quotaConsumed"
                            caching-type="external"
                            default-value="0" />
        <choose>
            <when condition="@(Convert.ToInt64((string)context.Variables[&quot;quotaConsumed&quot;]) >= (long)context.Variables[&quot;tenantQuotaLimit&quot;])">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <!-- Standards-compliant retry hint (period TTL is a safe upper bound). -->
                    <set-header name="Retry-After" exists-action="override">
                        <value>@(Convert.ToString((int)context.Variables[&quot;quotaTtlSeconds&quot;]))</value>
                    </set-header>
                    <set-body>@("{\"error\":{\"code\":\"TokenQuotaExceeded\",\"message\":\"Token quota of " + ((long)context.Variables["tenantQuotaLimit"]).ToString() + " per " + (string)context.Variables["quotaPeriodLabel"] + " exceeded for subscription '" + context.Subscription.Name + "'.\"}}")</set-body>
                </return-response>
            </when>
        </choose>
        <llm-token-limit counter-key="@(context.Subscription.Id)"
            tokens-per-minute="@((int)context.Variables[&quot;tpmCap&quot;])"
            estimate-prompt-tokens="true"
            remaining-tokens-variable-name="remainingTokens" />
        <set-variable name="remainingQuotaTokens"
                      value="@(Math.Max(0L, (long)context.Variables[&quot;tenantQuotaLimit&quot;] - Convert.ToInt64((string)context.Variables[&quot;quotaConsumed&quot;])))" />
        <!-- ═══════════════════════════════════════════════════════════════════
             STEP 4: Token Metrics Emitting (subscription + model dimensions)
             ═══════════════════════════════════════════════════════════════════ -->
        <azure-openai-emit-token-metric namespace="aigateway">
            <dimension name="Subscription ID" value="@(context.Subscription.Id)" />
            <dimension name="Subscription Name" value="@(context.Subscription.Name)" />
            <dimension name="Model" value="@((string)context.Variables["requestedModel"])" />
            <dimension name="API ID" value="@(context.Api.Id)" />
        </azure-openai-emit-token-metric>
        <!-- ═══════════════════════════════════════════════════════════════════
             STEP 5: Content Safety — shield prompts & block harmful categories
             ═══════════════════════════════════════════════════════════════════ -->
        %{ if enable_content_safety }
        <llm-content-safety backend-id="${content_safety_backend_id}" shield-prompt="true">
            <categories output-type="EightSeverityLevels">
                <category name="Hate" threshold="4" />
                <category name="SelfHarm" threshold="4" />
                <category name="Violence" threshold="4" />
            </categories>
        </llm-content-safety>
        %{ endif }
        <set-backend-service backend-id="${backend_id}" />
    </inbound>
    <backend>
        <retry count="2" 
               interval="0" 
               first-fast-retry="true" 
               condition="@(context.Response.StatusCode == 429 || (context.Response.StatusCode == 503 && !context.Response.StatusReason.Contains("Backend pool") && !context.Response.StatusReason.Contains("is temporarily unavailable")))">
            <forward-request buffer-request-body="true" />
        </retry>
    </backend>
    <outbound>
        <base />
        <!-- ─── Redis quota counter update ──────────────────────────────────
             Re-read the current counter (another process/replica may have
             incremented it since our inbound check), add this request's
             actual token count (read from usage.total_tokens in the LLM
             response), then write back with the period TTL.
             Read-modify-write is not atomic, but for quota-period-level
             enforcement (not millisecond concurrency) it is accurate enough.
             Streaming responses without `stream_options.include_usage=true`
             will report 0 tokens — handled gracefully via the (long?) cast.
             ──────────────────────────────────────────────────────────────── -->
        <choose>
            <when condition="@(context.Variables.ContainsKey(&quot;tenantQuotaKey&quot;))">
                <cache-lookup-value key="@((string)context.Variables[&quot;tenantQuotaKey&quot;])"
                                    variable-name="quotaConsumedCurrent"
                                    caching-type="external"
                                    default-value="0" />
                <set-variable name="tokensThisRequest"
                              value="@(context.Response.StatusCode == 200
                                  ? ((long?)((context.Response.Body?.As&lt;JObject&gt;(preserveContent: true))?[&quot;usage&quot;]?[&quot;total_tokens&quot;]) ?? 0L)
                                  : 0L)" />
                <set-variable name="newQuotaConsumed"
                              value="@(Convert.ToInt64((string)context.Variables[&quot;quotaConsumedCurrent&quot;]) + (long)context.Variables[&quot;tokensThisRequest&quot;])" />
                <cache-store-value key="@((string)context.Variables[&quot;tenantQuotaKey&quot;])"
                                   value="@(((long)context.Variables[&quot;newQuotaConsumed&quot;]).ToString())"
                                   duration="@((int)context.Variables[&quot;quotaTtlSeconds&quot;])"
                                   caching-type="external" />
                <set-variable name="remainingQuotaTokens"
                              value="@(Math.Max(0L, (long)context.Variables[&quot;tenantQuotaLimit&quot;] - (long)context.Variables[&quot;newQuotaConsumed&quot;]))" />
            </when>
        </choose>
        <set-header name="x-remaining-tpm-tokens" exists-action="override">
            <value>@(context.Variables.ContainsKey("remainingTokens") ? Convert.ToString(context.Variables["remainingTokens"]) : "n/a")</value>
        </set-header>
        <set-header name="x-remaining-quota-tokens" exists-action="override">
            <value>@(context.Variables.ContainsKey("remainingQuotaTokens") ? Convert.ToString(context.Variables["remainingQuotaTokens"]) : "n/a")</value>
        </set-header>
        <set-header name="x-quota-limit" exists-action="override">
            <value>@(context.Variables.ContainsKey("tenantQuotaLimit") ? Convert.ToString(context.Variables["tenantQuotaLimit"]) : "n/a")</value>
        </set-header>
        <set-header name="x-quota-period" exists-action="override">
            <value>@(context.Variables.ContainsKey("quotaPeriodLabel") ? (string)context.Variables["quotaPeriodLabel"] : "n/a")</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
        <choose>
            <!--Return a generic error that does not reveal backend pool details.-->
            <when condition="@(context.Response.StatusCode == 503)">
                <return-response>
                    <set-status code="503" reason="Service Unavailable" />
                </return-response>
            </when>
        </choose>
    </on-error>
</policies>
